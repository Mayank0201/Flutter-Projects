<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- ─── TOP SECTION: Branding & Stats ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CogniQ"
            android:textColor="#F0EBE3"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Stars Block -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginLeft="10dp">

            <TextView
                android:id="@+id/bronze_stars_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ 0"
                android:textColor="#CD7F32"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginRight="5dp" />

            <TextView
                android:id="@+id/silver_stars_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ 0"
                android:textColor="#C0C0C0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginRight="5dp" />

            <TextView
                android:id="@+id/gold_stars_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ 0"
                android:textColor="#FFD700"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spacer / Weight to push stats to the right -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="0dp" />

        <!-- Stats Block: Solved & Streak -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Solved Count -->
            <TextView
                android:id="@+id/total_solved_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F0EBE3"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Solved"
                android:textColor="#8A847C"
                android:textSize="10sp"
                android:layout_marginRight="8dp" />

            <!-- Streak Count -->
            <TextView
                android:id="@+id/streak_number_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#D4953A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Days"
                android:textColor="#8A847C"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Spacer to keep layout balanced -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="4dp" />

    <!-- ─── BOTTOM SECTION: Today's Daily ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: Puzzle Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY'S DAILY"
                android:textColor="#8A847C"
                android:textSize="8sp"
                android:textStyle="bold"
                android:layout_marginBottom="1dp" />

            <TextView
                android:id="@+id/puzzle_name_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grid Path"
                android:textColor="#F0EBE3"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/puzzle_desc_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Drag to fill the entire path"
                android:textColor="#8A847C"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Right: Compact Play Button -->
        <TextView
            android:id="@+id/play_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/play_btn_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="PLAY"
            android:textColor="#F0EBE3"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

</LinearLayout>
